<script>
  // Envelope open interaction
  const envelope = document.getElementById('envelope');
  const stage = document.getElementById('envelope-stage');
  const main = document.getElementById('main-content');
  envelope.addEventListener('click', () => {
    if(envelope.classList.contains('open')) return;
    envelope.classList.add('open');
    setTimeout(() => {
      stage.classList.add('hidden');
      main.classList.add('show');
      document.body.style.overflow = 'auto';
    }, 1000);
  });
  document.body.style.overflow = 'hidden';

  // Build calendar for September 2026 (30th = Wednesday)
  (function buildCalendar(){
    const grid = document.getElementById('calGrid');
    const dows = ['S','M','T','W','T','F','S'];
    dows.forEach(d=>{
      const el = document.createElement('div');
      el.className='dow'; el.textContent=d; grid.appendChild(el);
    });
    // Sept 1, 2026 is a Tuesday -> weekday index (Sun=0): Tue=2
    const firstWeekday = 2;
    const daysInMonth = 30;
    for(let i=0;i<firstWeekday;i++){
      const el=document.createElement('div');
      el.className='day empty';
      grid.appendChild(el);
    }
    for(let d=1; d<=daysInMonth; d++){
      const el=document.createElement('div');
      el.className='day' + (d===30 ? ' highlight' : '');
       if(d === 30){
         el.innerHTML = '30<span class="day-note">the big day</span>';
       } else {
         el.textContent=d;
       }
      grid.appendChild(el);
    }
  })();

  // Countdown to the big day
  (function initCountdown(){
    const target = new Date('2026-09-30T19:00:00');
    const dEl = document.getElementById('cdDays');
    const hEl = document.getElementById('cdHours');
    const mEl = document.getElementById('cdMins');
    const sEl = document.getElementById('cdSecs');

    function tick(){
      const now = new Date();
      let diff = target - now;
      if(diff <= 0){
        dEl.textContent = '0'; hEl.textContent = '0';
        mEl.textContent = '0'; sEl.textContent = '0';
        clearInterval(timer);
        return;
      }
      const days = Math.floor(diff / (1000*60*60*24));
      diff -= days * (1000*60*60*24);
      const hours = Math.floor(diff / (1000*60*60));
      diff -= hours * (1000*60*60);
      const mins = Math.floor(diff / (1000*60));
      diff -= mins * (1000*60);
      const secs = Math.floor(diff / 1000);

      dEl.textContent = days;
      hEl.textContent = hours;
      mEl.textContent = mins;
      sEl.textContent = secs;
    }
    tick();
    const timer = setInterval(tick, 1000);
  })();

  // Photo carousel — swing through memories
  (function initCarousel(){
    const stage = document.getElementById('carouselStage');
    const frames = Array.from(stage.querySelectorAll('.photo-frame'));
    const dotsWrap = document.getElementById('carouselDots');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    let current = 0;

     // Ensure every photo has the same tap-to-reveal veil.
     frames.forEach(f => {
       if(f.querySelector('.reveal-veil')) return;
       const veil = document.createElement('div');
       veil.className = 'reveal-veil';
       veil.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3c4.8 0 8.5 4.1 9.5 9-1 4.9-4.7 9-9.5 9S3.5 16.9 2.5 12C3.5 7.1 7.2 3 12 3Z"/><circle cx="12" cy="12" r="3"/></svg><span>Tap to reveal</span>';
       f.querySelector('.img-wrap').appendChild(veil);
     });

    frames.forEach((_, i) => {
      const dot = document.createElement('div');
      dot.className = 'dot' + (i === 0 ? ' active' : '');
      dot.addEventListener('click', () => goTo(i));
      dotsWrap.appendChild(dot);
    });
    const dots = Array.from(dotsWrap.querySelectorAll('.dot'));

    function render(){
      frames.forEach((f, i) => {
        f.classList.remove('active','prev-exit','next-exit');
        if(i === current){
          f.classList.add('active');
        }
      });
      dots.forEach((d,i) => d.classList.toggle('active', i === current));
    }

    function goTo(i){
      current = (i + frames.length) % frames.length;
      render();
    }

    prevBtn.addEventListener('click', () => goTo(current - 1));
    nextBtn.addEventListener('click', () => goTo(current + 1));

    // tap the photo itself to advance
    frames.forEach(f => {
      const veil = f.querySelector('.reveal-veil');
      if(veil){
        veil.addEventListener('click', (e) => {
          e.stopPropagation();
          f.classList.add('revealed');
        });
      }
      f.addEventListener('click', () => {
        if(veil && !f.classList.contains('revealed')){
          f.classList.add('revealed');
          return;
        }
        goTo(current + 1);
      });
    });

    // swipe support
    let touchStartX = 0;
    stage.addEventListener('touchstart', e => { touchStartX = e.touches[0].clientX; }, {passive:true});
    stage.addEventListener('touchend', e => {
      const dx = e.changedTouches[0].clientX - touchStartX;
      if(Math.abs(dx) > 40){
        dx < 0 ? goTo(current + 1) : goTo(current - 1);
      }
    }, {passive:true});

    render();
  })();

  // Send wishes via Email
  document.getElementById('sendWishBtn').addEventListener('click', () => {
    const name = document.getElementById('wishName').value.trim();
    const msg = document.getElementById('wishMsg').value.trim();
    if(!msg){
      document.getElementById('wishMsg').focus();
      return;
    }
    const toEmail = 'aggmath@hotmail.com';
    const subject = name ? `Wishes for Nada & Yassen from ${name}` : 'Wishes for Nada & Yassen';
    const body = `${msg}\n\n🕸️🤍`;
    const url = `mailto:${toEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    window.location.href = url;
  });

  // Add to calendar (.ics)
  document.getElementById('addCalBtn').addEventListener('click', () => {
    const ics = [
      'BEGIN:VCALENDAR',
      'VERSION:2.0',
      'BEGIN:VEVENT',
      'SUMMARY:Nada & Yassen\'s Engagement',
      'DTSTART:20260930T190000',
      'DTEND:20260930T230000',
      'LOCATION:Diamond Castle',
      'DESCRIPTION:Join Nada & Yassen as they celebrate their engagement at Diamond Castle.',
      'END:VEVENT',
      'END:VCALENDAR'
    ].join('\r\n');
    const blob = new Blob([ics], {type:'text/calendar'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'Nada-Yassen-Engagement.ics';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });
</script>

